{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cta-track-grid",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // Serve the monitor frontend (public/) straight from the edge.
  // Asset paths are served before the Worker runs; only non-asset
  // paths (e.g. /api/*) invoke src/index.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  },

  // Custom domain — wrangler provisions the DNS record + cert on the
  // debene.dev Cloudflare zone automatically on deploy. Keep the original
  // *.workers.dev URL alive alongside it.
  "workers_dev": true,
  "routes": [
    { "pattern": "tracker.debene.dev", "custom_domain": true }
  ],

  // Position history store (see migrations/0001_init.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cta_history",
      "database_id": "ce905855-559f-45df-9d66-a4f767f22b32"
    }
  ],

  // Workers AI — Deepgram Aura TTS for the spoken dispatcher narration.
  // remote:true lets `wrangler dev` reach the real model (AI has no local sim);
  // it is a dev-only hint and has no effect on production.
  "ai": { "binding": "AI", "remote": true },

  // R2 — caches the generated narration audio (mp3), keyed by narration hash.
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "cta-narration" }
  ],

  // Cron capture/purge retired: position collection moved to the cta-snapshot
  // K8s collector (one row/train/tick into TimescaleDB), and D1 retention is
  // handled there by a TimescaleDB retention policy. Empty list removes all
  // cron triggers on deploy. The Worker still serves its HTTP/read API.
  "triggers": {
    "crons": []
  }

  // CTA_KEY is a secret, set with: wrangler secret put CTA_KEY
  // For local dev, put it in .dev.vars instead.
}
