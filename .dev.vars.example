# Copy to .dev.vars for local `wrangler dev`. Get a key at
# https://www.transitchicago.com/developers/traintrackerapply/
CTA_KEY=YOUR_CTA_KEY

# Metra GTFS-realtime API token (Sanctum bearer). Request one at
# https://metra.com/metra-gtfs-api
METRA_TOKEN=YOUR_METRA_TOKEN

# DeepSeek API key — powers the /api/alerts/summary AI SITREP. https://platform.deepseek.com
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Ticketmaster Discovery API Consumer Key — concerts/festivals for /api/events/advisory.
# Optional: without it the event advisory runs sports-only (keyless ESPN). https://developer.ticketmaster.com
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_CONSUMER_KEY
